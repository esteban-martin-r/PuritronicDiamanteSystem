# Database Configuration
MYSQL_HOST=db
MYSQL_DATABASE=purificadora
# CAMBIO: Usa un nombre distinto a root para el usuario normal
MYSQL_USER=db_user
MYSQL_PASSWORD=1234
MYSQL_ROOT_PASSWORD=1234

# PHPMyAdmin Configuration
PMA_HOST=db
PMA_USER=root
PMA_PASSWORD=1234

# Ports Configuration
APACHE_PORT=80
# Mantenemos el 3308 para evitar el error de "ports not available"
MYSQL_PORT=3308
PHPMYADMIN_PORT=8080

# PHP Configuration
PHP_MEMORY_LIMIT=256M
PHP_MAX_EXECUTION_TIME=30
PHP_UPLOAD_MAX_FILESIZE=20M
PHP_POST_MAX_SIZE=20M
